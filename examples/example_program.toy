# This is a sample program demonstrating our language features

# Variables and arithmetic operations
x = 10;
y = 5;
sum = x + y;
print("sum");
print(sum);

# If-else statement
if (x > y) {
    print("x is greater than y");
    print(x);
} else {
    print("y is greater than x");
    print(y);
}

# While loop to calculate factorial
n = 5;
factorial = 1;
while (n > 0) {
    factorial = factorial * n;
    n = n - 1;
}
print("factorial");
print(factorial);

# While loop to generate Fibonacci sequence
fib1 = 0;
fib2 = 1;
count = 0;
print("Fibonacci sequence:");
while (count < 10) {
    print(fib1);
    next = fib1 + fib2;
    fib1 = fib2;
    fib2 = next;
    count = count + 1;
}

# Test for loop
print("For loop:");
for (i = 0; i < 5; i = i + 1) {
    print(i);
}

# Test if statement with logical operators
x = 1;
y = 0;
print("Logical operators:");
if (x && y) {
    print(x + y);
} else {
    print(x - y);
}

# Test for elseif statement
x = 10;
y = 5;
if (x == y) {
    print("x is equal to y");
} elseif (x != y) {
    print("x is not equal to y");
} else {
    print("Invalid");
}

a = "Hello" + "ing";
print(a);

